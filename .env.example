# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# A long random string used to sign sessions/cookies. Generate one with:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# REQUIRED whenever DEBUG=False — the app refuses to start without it rather
# than silently falling back to an insecure default key.
SECRET_KEY=

# "True" for local development. Defaults to "False" if unset at all — the
# app fails safe (no debug info exposed) rather than failing open.
DEBUG=True

# Comma-separated list of hostnames the site is allowed to answer as, e.g.
#   ALLOWED_HOSTS=example.com,www.example.com
# Not needed on Render (RENDER_EXTERNAL_HOSTNAME covers that automatically)
# or in local dev (DEBUG=True already allows localhost/127.0.0.1/ngrok).
# Only needed if you deploy somewhere other than Render.
ALLOWED_HOSTS=

# The admin login path. Defaults to "staff-portal/" (not the well-known
# "/admin/") if unset — set your own if you want something different.
ADMIN_URL=

# Leave blank to use the local SQLite database (fine for development).
# In production, set this to your Postgres connection string, e.g. from Render:
#   postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- Email ---
# Leave EMAIL_HOST blank to print emails to the console instead of sending them
# (useful for local development without a real mail account).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# The "From" address on outgoing emails.
DEFAULT_FROM_EMAIL=noreply@talchessacademy.example

# Where new registration/contact notifications are sent to (the academy's inbox).
ACADEMY_NOTIFICATION_EMAIL=info@talchessacademy.example
